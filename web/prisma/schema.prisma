generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MemberRole {
  OWNER
  FAMILY_MEMBER

  @@map("member_role")
}

enum MemberStatus {
  INVITED
  ACTIVE
  REMOVED

  @@map("member_status")
}

enum PatientStatus {
  ACTIVE
  INACTIVE
  END_OF_CARE
  DECEASED

  @@map("patient_status")
}

enum PatientDeactivationReason {
  NO_LONGER_CARED
  PATIENT_DECEASED
  OTHER

  @@map("patient_deactivation_reason")
}

enum ProfileFactStatus {
  UNKNOWN
  NONE_REPORTED
  REPORTED

  @@map("profile_fact_status")
}

enum BpjsMembershipStatus {
  UNKNOWN
  NOT_REGISTERED
  REGISTERED

  @@map("bpjs_membership_status")
}

enum AccessCodeStatus {
  ACTIVE
  REVOKED
  EXPIRED

  @@map("access_code_status")
}

enum ActorType {
  CAREGIVER
  PATIENT
  SYSTEM

  @@map("actor_type")
}

enum CheckInMood {
  GOOD
  OKAY
  UNWELL

  @@map("check_in_mood")
}

enum MedicationStatus {
  ACTIVE
  PAUSED
  ENDED

  @@map("medication_status")
}

enum MedicationLogStatus {
  TAKEN
  MISSED
  SKIPPED

  @@map("medication_log_status")
}

enum ReminderType {
  MEDICATION
  CHECK_IN
  DOCTOR_VISIT
  BPJS
  OTHER

  @@map("reminder_type")
}

enum ReminderStatus {
  UPCOMING
  DONE
  MISSED
  SKIPPED

  @@map("reminder_status")
}

model User {
  id                         String                 @id @db.Uuid
  displayName                String                 @map("display_name") @db.VarChar(120)
  phoneNumber                String?                @map("phone_number") @db.VarChar(32)
  avatarPath                 String?                @map("avatar_path") @db.Text
  createdAt                  DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdCareCircles         CareCircle[]           @relation("CareCircleCreatedBy")
  memberships                CareCircleMember[]     @relation("CareCircleMemberUser")
  invitedMemberships         CareCircleMember[]     @relation("CareCircleMemberInviter")
  createdInvitations         CareCircleInvitation[] @relation("CareCircleInvitationCreatedBy")
  acceptedInvitations        CareCircleInvitation[] @relation("CareCircleInvitationAcceptedBy")
  createdPatientProfiles     PatientProfile[]       @relation("PatientProfileCreatedBy")
  updatedPatientProfiles     PatientProfile[]       @relation("PatientProfileUpdatedBy")
  deactivatedPatientProfiles PatientProfile[]       @relation("PatientProfileDeactivatedBy")
  createdPatientAccessCodes  PatientAccessCode[]    @relation("PatientAccessCodeCreatedBy")
  submittedCheckIns          CheckIn[]              @relation("CheckInSubmittedByUser")
  createdMedications         Medication[]           @relation("MedicationCreatedBy")
  updatedMedications         Medication[]           @relation("MedicationUpdatedBy")
  recordedMedicationLogs     MedicationLog[]        @relation("MedicationLogRecordedBy")
  createdReminders           Reminder[]             @relation("ReminderCreatedBy")
  createdHealthNotes         HealthNote[]           @relation("HealthNoteCreatedBy")
  updatedHealthNotes         HealthNote[]           @relation("HealthNoteUpdatedBy")
  auditEvents                AuditEvent[]           @relation("AuditActorUser")

  @@map("users")
}

model CareCircle {
  id              String                 @id @default(uuid()) @db.Uuid
  name            String                 @db.VarChar(120)
  createdByUserId String                 @map("created_by_user_id") @db.Uuid
  isActive        Boolean                @default(true) @map("is_active")
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy       User                   @relation("CareCircleCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  members         CareCircleMember[]
  invitations     CareCircleInvitation[]
  patientProfiles PatientProfile[]
  auditEvents     AuditEvent[]

  @@map("care_circles")
}

model CareCircleMember {
  id              String       @id @default(uuid()) @db.Uuid
  careCircleId    String       @map("care_circle_id") @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  role            MemberRole
  status          MemberStatus
  invitedByUserId String?      @map("invited_by_user_id") @db.Uuid
  joinedAt        DateTime?    @map("joined_at") @db.Timestamptz(6)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  careCircle      CareCircle   @relation(fields: [careCircleId], references: [id], onDelete: Restrict)
  user            User         @relation("CareCircleMemberUser", fields: [userId], references: [id], onDelete: Restrict)
  invitedBy       User?        @relation("CareCircleMemberInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@unique([careCircleId, userId])
  @@index([userId, status])
  @@map("care_circle_members")
}

model CareCircleInvitation {
  id               String     @id @default(uuid()) @db.Uuid
  careCircleId     String     @map("care_circle_id") @db.Uuid
  codeHash         String     @unique @map("code_hash") @db.VarChar(255)
  expiresAt        DateTime   @map("expires_at") @db.Timestamptz(6)
  createdByUserId  String     @map("created_by_user_id") @db.Uuid
  acceptedByUserId String?    @map("accepted_by_user_id") @db.Uuid
  acceptedAt       DateTime?  @map("accepted_at") @db.Timestamptz(6)
  revokedAt        DateTime?  @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  careCircle       CareCircle @relation(fields: [careCircleId], references: [id], onDelete: Restrict)
  createdBy        User       @relation("CareCircleInvitationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  acceptedBy       User?      @relation("CareCircleInvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: Restrict)

  @@map("care_circle_invitations")
}

model PatientProfile {
  id                       String                     @id @default(uuid()) @db.Uuid
  careCircleId             String                     @map("care_circle_id") @db.Uuid
  displayName              String                     @map("display_name") @db.VarChar(120)
  relationshipLabel        String                     @map("relationship_label") @db.VarChar(32)
  dateOfBirth              DateTime?                  @map("date_of_birth") @db.Date
  city                     String?                    @db.VarChar(80)
  locationLabel            String?                    @map("location_label") @db.VarChar(160)
  primaryConditions        String[]                   @default([]) @map("primary_conditions")
  primaryConditionsStatus  ProfileFactStatus          @default(UNKNOWN) @map("primary_conditions_status")
  allergies                String[]                   @default([])
  allergiesStatus          ProfileFactStatus          @default(UNKNOWN) @map("allergies_status")
  currentMedicationsStatus ProfileFactStatus          @default(UNKNOWN) @map("current_medications_status")
  bpjsNumberLast4          String?                    @map("bpjs_number_last4") @db.VarChar(4)
  bpjsMembershipStatus     BpjsMembershipStatus       @default(UNKNOWN) @map("bpjs_membership_status")
  usualFacilityName        String?                    @map("usual_facility_name") @db.VarChar(160)
  emergencyContactName     String?                    @map("emergency_contact_name") @db.VarChar(120)
  emergencyContactPhone    String?                    @map("emergency_contact_phone") @db.VarChar(32)
  emergencyContactStatus   ProfileFactStatus          @default(UNKNOWN) @map("emergency_contact_status")
  status                   PatientStatus              @default(ACTIVE)
  deactivationReason       PatientDeactivationReason? @map("deactivation_reason")
  deactivationNote         String?                    @map("deactivation_note") @db.VarChar(500)
  deactivatedByUserId      String?                    @map("deactivated_by_user_id") @db.Uuid
  deactivatedAt            DateTime?                  @map("deactivated_at") @db.Timestamptz(6)
  createdByUserId          String                     @map("created_by_user_id") @db.Uuid
  updatedByUserId          String?                    @map("updated_by_user_id") @db.Uuid
  createdAt                DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                DateTime?                  @map("deleted_at") @db.Timestamptz(6)
  careCircle               CareCircle                 @relation(fields: [careCircleId], references: [id], onDelete: Restrict)
  createdBy                User                       @relation("PatientProfileCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy                User?                      @relation("PatientProfileUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  deactivatedBy            User?                      @relation("PatientProfileDeactivatedBy", fields: [deactivatedByUserId], references: [id], onDelete: Restrict)
  accessCodes              PatientAccessCode[]
  sessions                 PatientSession[]
  checkIns                 CheckIn[]
  medications             Medication[]
  medicationLogs          MedicationLog[]
  reminders               Reminder[]
  healthNotes             HealthNote[]
  auditEvents              AuditEvent[]               @relation("AuditTargetPatientProfile")
  actorAuditEvents         AuditEvent[]               @relation("AuditActorPatientProfile")

  @@index([careCircleId, status])
  @@map("patient_profiles")
}

model PatientAccessCode {
  id                 String           @id @default(uuid()) @db.Uuid
  patientProfileId   String           @map("patient_profile_id") @db.Uuid
  codeHash           String           @unique @map("code_hash") @db.VarChar(255)
  status             AccessCodeStatus @default(ACTIVE)
  failedAttemptCount Int              @default(0) @map("failed_attempt_count") @db.SmallInt
  lockedUntil        DateTime?        @map("locked_until") @db.Timestamptz(6)
  lastUsedAt         DateTime?        @map("last_used_at") @db.Timestamptz(6)
  expiresAt          DateTime?        @map("expires_at") @db.Timestamptz(6)
  createdByUserId    String           @map("created_by_user_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  patientProfile     PatientProfile   @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)
  createdBy          User             @relation("PatientAccessCodeCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@map("patient_access_codes")
}

model PatientSession {
  id               String         @id @default(uuid()) @db.Uuid
  patientProfileId String         @map("patient_profile_id") @db.Uuid
  tokenHash        String         @unique @map("token_hash") @db.VarChar(255)
  expiresAt        DateTime       @map("expires_at") @db.Timestamptz(6)
  lastSeenAt       DateTime       @map("last_seen_at") @db.Timestamptz(6)
  revokedAt        DateTime?      @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  patientProfile   PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)

  @@map("patient_sessions")
}

model CheckIn {
  id                 String         @id @default(uuid()) @db.Uuid
  patientProfileId   String         @map("patient_profile_id") @db.Uuid
  submittedByUserId  String?        @map("submitted_by_user_id") @db.Uuid
  submittedByPatient Boolean        @default(false) @map("submitted_by_patient")
  mood               CheckInMood
  conditionText      String?        @map("condition_text") @db.Text
  painLevel          Int?           @map("pain_level") @db.SmallInt
  medicationTaken    Boolean?       @map("medication_taken")
  complaintText      String?        @map("complaint_text") @db.Text
  needsFamilyHelp    Boolean        @default(false) @map("needs_family_help")
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  patientProfile     PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)
  submittedBy        User?          @relation("CheckInSubmittedByUser", fields: [submittedByUserId], references: [id], onDelete: Restrict)

  @@index([patientProfileId, createdAt(sort: Desc)])
  @@map("check_ins")
}

model Medication {
  id               String           @id @default(uuid()) @db.Uuid
  patientProfileId String           @map("patient_profile_id") @db.Uuid
  name             String           @db.VarChar(160)
  doseText         String           @map("dose_text") @db.VarChar(160)
  scheduleText     String           @map("schedule_text") @db.VarChar(240)
  instructions     String?          @db.Text
  startDate        DateTime?        @map("start_date") @db.Date
  endDate          DateTime?        @map("end_date") @db.Date
  status           MedicationStatus @default(ACTIVE)
  createdByUserId  String           @map("created_by_user_id") @db.Uuid
  updatedByUserId  String           @map("updated_by_user_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  patientProfile   PatientProfile   @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)
  createdBy        User             @relation("MedicationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy        User             @relation("MedicationUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  logs             MedicationLog[]
  reminders        Reminder[]

  @@index([patientProfileId, status])
  @@map("medications")
}

model MedicationLog {
  id                String              @id @default(uuid()) @db.Uuid
  patientProfileId  String              @map("patient_profile_id") @db.Uuid
  medicationId      String              @map("medication_id") @db.Uuid
  status            MedicationLogStatus
  scheduledFor      DateTime?           @map("scheduled_for") @db.Timestamptz(6)
  recordedByUserId  String?             @map("recorded_by_user_id") @db.Uuid
  recordedByPatient Boolean             @default(false) @map("recorded_by_patient")
  recordedAt        DateTime            @default(now()) @map("recorded_at") @db.Timestamptz(6)
  patientProfile    PatientProfile      @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)
  medication        Medication          @relation(fields: [medicationId], references: [id], onDelete: Restrict)
  recordedBy        User?               @relation("MedicationLogRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@index([patientProfileId, recordedAt(sort: Desc)])
  @@index([medicationId, recordedAt(sort: Desc)])
  @@map("medication_logs")
}

model Reminder {
  id                  String         @id @default(uuid()) @db.Uuid
  patientProfileId    String         @map("patient_profile_id") @db.Uuid
  type                ReminderType
  title               String         @db.VarChar(160)
  description         String?        @db.Text
  scheduledAt         DateTime?      @map("scheduled_at") @db.Timestamptz(6)
  scheduleText        String?        @map("schedule_text") @db.VarChar(240)
  status              ReminderStatus @default(UPCOMING)
  relatedMedicationId String?        @map("related_medication_id") @db.Uuid
  createdByUserId     String         @map("created_by_user_id") @db.Uuid
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  patientProfile      PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)
  relatedMedication   Medication?    @relation(fields: [relatedMedicationId], references: [id], onDelete: Restrict)
  createdBy           User           @relation("ReminderCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([patientProfileId, status, scheduledAt])
  @@map("reminders")
}

model HealthNote {
  id               String         @id @default(uuid()) @db.Uuid
  patientProfileId String         @map("patient_profile_id") @db.Uuid
  title            String         @db.VarChar(160)
  noteText         String         @map("note_text") @db.Text
  category         String         @db.VarChar(48)
  createdByUserId  String         @map("created_by_user_id") @db.Uuid
  updatedByUserId  String         @map("updated_by_user_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  patientProfile   PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)
  createdBy        User           @relation("HealthNoteCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy        User           @relation("HealthNoteUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)

  @@index([patientProfileId, createdAt(sort: Desc)])
  @@map("health_notes")
}

model AuditEvent {
  id                    String          @id @default(uuid()) @db.Uuid
  careCircleId          String          @map("care_circle_id") @db.Uuid
  patientProfileId      String?         @map("patient_profile_id") @db.Uuid
  actorType             ActorType       @map("actor_type")
  actorUserId           String?         @map("actor_user_id") @db.Uuid
  actorPatientProfileId String?         @map("actor_patient_profile_id") @db.Uuid
  actorRole             String?         @map("actor_role") @db.VarChar(32)
  action                String          @db.VarChar(80)
  targetType            String          @map("target_type") @db.VarChar(80)
  targetId              String?         @map("target_id") @db.Uuid
  summary               String          @db.VarChar(500)
  requestId             String?         @map("request_id") @db.VarChar(80)
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  careCircle            CareCircle      @relation(fields: [careCircleId], references: [id], onDelete: Restrict)
  patientProfile        PatientProfile? @relation("AuditTargetPatientProfile", fields: [patientProfileId], references: [id], onDelete: Restrict)
  actorUser             User?           @relation("AuditActorUser", fields: [actorUserId], references: [id], onDelete: Restrict)
  actorPatientProfile   PatientProfile? @relation("AuditActorPatientProfile", fields: [actorPatientProfileId], references: [id], onDelete: Restrict)

  @@index([careCircleId, createdAt(sort: Desc)])
  @@index([patientProfileId, createdAt(sort: Desc)])
  @@map("audit_events")
}
